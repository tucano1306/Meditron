generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  /// Empresa o negocio de la persona; en los reportes sale "Nombre / Empresa"
  businessName String?
  hourlyRate   Float    @default(25)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timeEntries    TimeEntry[]
  weeks          Week[]
  monthSummaries MonthSummary[]
  paymentEntries PaymentEntry[]
  companies      Company[]
  orgMembers     OrgMember[]
}

// Compañía (empleador) de un usuario. Cada persona configura las suyas: qué
// datos registra por trabajo, en qué día empieza su semana de pago y cómo se
// le paga (ver CompanyPayRule).
model Company {
  id               String   @id @default(cuid())
  name             String
  color            String   @default("#37352f")
  /// Día en que empieza la semana de pago: 0 = domingo ... 6 = sábado
  weekStartsOn     Int      @default(1)
  trackJobNumber   Boolean  @default(false)
  trackVehicle     Boolean  @default(false)
  trackServiceType Boolean  @default(false)
  trackCompanyPaid Boolean  @default(false)
  archived         Boolean  @default(false)
  sortOrder        Int      @default(0)
  /// Correos que reciben el reporte semanal, separados por coma
  reportEmails     String?
  /// Enviar solo el reporte al terminar cada semana de pago
  autoSendReport   Boolean  @default(false)
  /// Break sin pago que se descuenta de cada turno, en minutos (0 = no se descuenta)
  breakMinutes     Int      @default(0)
  /// El break solo se descuenta en turnos de al menos estas horas (0 = en todos)
  breakAfterHours  Float    @default(6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payRules         CompanyPayRule[]
  timeEntries      TimeEntry[]
  reportDeliveries ReportDelivery[]
  weekPayments     WeekPayment[]

  @@index([userId])
}

// Envío por correo del reporte de una semana de pago (para saber qué semanas
// ya se mandaron y a quién)
model ReportDelivery {
  id         String   @id @default(cuid())
  /// Primer día de la semana de pago enviada
  weekStart  DateTime @db.Date
  /// Destinatarios, separados por coma
  recipients String
  /// Lo envió el envío automático semanal (no el usuario)
  automatic  Boolean  @default(false)
  sentAt     DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, weekStart])
}

// Esquema de pago de una compañía a partir de una fecha. Al cambiar la tarifa
// se agrega una versión nueva, así las semanas anteriores conservan su cálculo.
model CompanyPayRule {
  id                 String   @id @default(cuid())
  effectiveFrom      DateTime @db.Date
  /// 'hourly' | 'weekly_overtime' | 'daily_overtime'
  payType            String   @default("hourly")
  hourlyRate         Float
  overtimeAfterHours Float?
  overtimeMultiplier Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, effectiveFrom])
  @@index([companyId])
}

model TimeEntry {
  id                     String    @id @default(cuid())
  startTime              DateTime
  endTime                DateTime?
  duration               Int?
  date                   DateTime  @db.Date
  jobNumber              String?
  vehicle                String?
  observation            String?
  calculatedAmount       Float?
  paidAmount             Float?
  companyPaid            Float?
  companyPaidDate        DateTime?
  serviceType            String?
  pausedAt               DateTime?
  accumulatedSeconds     Int       @default(0)
  lastResumeTime         DateTime?
  correctionPending      Boolean   @default(false)
  correctionNote         String?
  correctionResolved     Boolean   @default(false)
  correctionResolvedNote String?
  /// Break sin pago ya descontado de `duration`, en segundos. En un turno en
  /// curso: null = según la compañía al terminar, 0 = no descontar
  breakSeconds           Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekId    String
  week      Week     @relation(fields: [weekId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([weekId])
  @@index([userId])
  @@index([companyId])
}

model Week {
  id         String   @id @default(cuid())
  weekNumber Int
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  year       Int
  month      Int
  totalHours Float    @default(0)
  earnings   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries TimeEntry[]

  @@unique([weekNumber, year, userId])
  @@index([year, month])
  @@index([userId])
}

model MonthSummary {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  totalHours  Float    @default(0)
  earnings    Float    @default(0)
  companyPaid Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([year, month, userId])
  @@index([userId])
}

model PaymentEntry {
  id              String    @id @default(cuid())
  startTime       DateTime
  endTime         DateTime?
  duration        Int?
  amount          Float?
  hourlyRate      Float?
  jobNumber       String?
  vehicle         String?
  date            DateTime  @db.Date
  completed       Boolean   @default(false)
  companyPaid     Float?
  companyPaidDate DateTime?
  /// Propina recibida (aparte del pago)
  tip             Float?
  /// Cliente o descripción del trabajo
  client          String?
  notes           String?
  /// cash | zelle | card | check | transfer | app | other
  paymentMethod   String?
  /// paid (cobrado) | pending (por cobrar)
  paymentStatus   String    @default("paid")
  /// Cuándo se cobró
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId])
  @@index([userId, paymentStatus])
}

/// Intentos recientes de acciones sensibles (inicio de sesión fallido,
/// registro) para frenar ataques de fuerza bruta. Se limpian solos.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// Pago que hizo la empresa por una semana de pago (lo que dice el talonario),
/// para saber qué semanas ya se cobraron y comparar con lo que calcula la app
model WeekPayment {
  id        String   @id @default(cuid())
  /// Primer día de la semana de pago
  weekStart DateTime @db.Date
  /// Lo que pagó la empresa por la semana, bruto (antes de impuestos)
  amount    Float
  /// Lo que llegó al banco o el cheque, después de impuestos (opcional)
  netAmount Float?
  /// Horas que pagó la empresa según el talonario (opcional)
  hours     Float?
  /// Día en que se recibió el pago
  paidOn    DateTime @db.Date
  /// Número de cheque, depósito o talonario (opcional)
  reference String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekStart])
}

// ── Modo empresa: los empleados marcan entrada y salida y solo el
// administrador puede cambiar las horas ─────────────────────────────────────

/// Empresa que controla la entrada y salida de sus empleados
model Organization {
  id                 String   @id @default(cuid())
  name               String
  /// Código con el que los empleados piden unirse
  joinCode           String   @unique
  /// Día en que empieza la semana de pago: 0 = domingo ... 6 = sábado
  weekStartsOn       Int      @default(1)
  /// Exigir estar dentro del radio de una oficina para marcar
  requireLocation    Boolean  @default(true)
  overtimeAfterHours Float    @default(40)
  overtimeMultiplier Float    @default(1.5)
  /// Break sin pago que se descuenta al marcar la salida (0 = ninguno)
  breakMinutes       Int      @default(0)
  breakAfterHours    Float    @default(6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members   OrgMember[]
  locations OrgLocation[]
  shifts    OrgShift[]
}

/// Oficina donde se puede marcar: centro y radio
model OrgLocation {
  id           String   @id @default(cuid())
  name         String
  address      String
  latitude     Float
  longitude    Float
  /// Radio permitido en metros (1 milla = 1609 m)
  radiusMeters Float    @default(1609.34)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Persona dentro de una empresa
model OrgMember {
  id         String   @id @default(cuid())
  /// admin | employee
  role       String   @default("employee")
  /// pending (pidió unirse) | active | inactive
  status     String   @default("pending")
  hourlyRate Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts OrgShift[]

  @@unique([orgId, userId])
  @@index([userId])
}

/// Turno marcado por un empleado (o agregado por un administrador). La hora la
/// pone el servidor; el empleado no puede cambiarla
model OrgShift {
  id               String    @id @default(cuid())
  clockIn          DateTime
  clockOut         DateTime?
  /// Día (de Florida) de la entrada
  date             DateTime  @db.Date
  /// Break sin pago descontado al marcar la salida
  breakSeconds     Int       @default(0)
  inLatitude       Float?
  inLongitude      Float?
  inAccuracy       Float?
  /// Metros a la oficina más cercana al marcar
  inDistance       Float?
  outLatitude      Float?
  outLongitude     Float?
  outAccuracy      Float?
  outDistance      Float?
  /// clock (marcado por el empleado) | admin (agregado por un administrador)
  source           String    @default("clock")
  /// Pedido de corrección del empleado
  correctionNote   String?
  /// pending | resolved | rejected
  correctionStatus String?
  /// Respuesta del administrador
  adminNote        String?
  /// Borrado por un administrador (se conserva para el historial)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orgId    String
  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberId String
  member   OrgMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  edits    OrgShiftEdit[]

  @@index([orgId, date])
  @@index([memberId, clockIn])
}

/// Historial de cambios de un turno: quién, cuándo, antes, después y por qué
model OrgShiftEdit {
  id        String   @id @default(cuid())
  /// create | update | delete | resolve | reject
  action    String
  before    Json?
  after     Json?
  reason    String
  /// Usuario que hizo el cambio
  editorId  String
  createdAt DateTime @default(now())

  shiftId String
  shift   OrgShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}
